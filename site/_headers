# Five-minute cache everywhere: paths are unversioned, so a redraw must reach consumers without a redeploy.
# No X-Robots-Tag on /mark/*, /share/* or /tokens.css: Google must be able to fetch the favicon, og:image and CSS.

/
  X-Robots-Tag: noindex

/photo/*
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=300

/social/*
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=300

/share/*
  Cache-Control: public, max-age=300

/mark/*
  Cache-Control: public, max-age=300

/tokens.css
  Cache-Control: public, max-age=300

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
